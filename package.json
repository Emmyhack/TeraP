{
  "name": "terap-universal",
  "version": "1.0.0",
  "description": "TeraP - Universal Therapist and Wellness DAO Platform",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "forge build",
    "test": "forge test",
    "abi": "forge build && node scripts/export-abi.mjs",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --legacy",
    "deploy:testnet": "forge script script/Deploy.s.sol --rpc-url https://zetachain-athens-evm.blockpi.network/v1/rpc/public --broadcast --legacy",
    "deploy:mainnet": "forge script script/Deploy.s.sol --rpc-url https://zetachain-evm.blockpi.network/v1/rpc/public --broadcast --legacy",
    "upgrade:testnet": "forge script script/Upgrade.s.sol --rpc-url https://zetachain-athens-evm.blockpi.network/v1/rpc/public --broadcast --legacy",
    "upgrade:mainnet": "forge script script/Upgrade.s.sol --rpc-url https://zetachain-evm.blockpi.network/v1/rpc/public --broadcast --legacy"
  },
  "keywords": [
    "web3",
    "dao",
    "wellness",
    "therapy",
    "zetachain",
    "omnichain"
  ],
  "author": "TeraP Team",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "ethers": "^6.15.0",
    "lucide-react": "^0.400.0",
    "next": "14.2.35",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.0",
    "typescript": "^5.0.0"
  }
}
